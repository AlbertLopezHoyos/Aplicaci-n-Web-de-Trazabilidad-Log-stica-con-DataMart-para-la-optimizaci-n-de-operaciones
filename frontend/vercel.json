{
  "build": {
    "env": {
      "VITE_DEMO_MODE": "false",
      "VITE_API_URL": "/api"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aplicaci-n-web-de-trazabilidad-log-stica.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://aplicaci-n-web-de-trazabilidad-log-stica.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
