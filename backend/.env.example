# Servidor
PORT=5000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trazabilidad_logistica
DB_USER=root
DB_PASSWORD=

# Alternativa en Render: pegar MYSQL_PUBLIC_URL de Railway
# DATABASE_URL=mysql://root:password@host:port/railway

# JWT
JWT_SECRET=cambiar_por_clave_segura_minimo_32_caracteres
JWT_EXPIRES_IN=8h

# CORS (varias URLs separadas por coma en producción)
CORS_ORIGIN=http://localhost:5173

# SSL para MySQL en la nube (Railway, etc.)
DB_SSL=false

# Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=uploads
